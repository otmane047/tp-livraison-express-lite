# Copy this file to .env.
#
# In this correction, every default lives in src/livraison_express_lite/config.py:
# a key left EMPTY below means "use that default". Filling a key overrides it.

# --- General ---
# environment: local | test | prod
ENVIRONMENT=local

# --- Model ---
# Path to the .joblib file
MODEL_PATH=notebooks/artifacts/express_delivery_model.joblib

# URI du modèle enregistré dans MLflow (ex. runs:/<run_id>/model).
MLFLOW_MODEL_URI=

# Decision threshold above which an order is considered eligible.
MODEL_THRESHOLD=0.5

# Version of the model served by the API.
MODEL_VERSION=1.0.0

# --- Data store ---
# Connection string or path of the store you implement for your OrderStore adapter.
# Examples: memory://, sqlite:///./local.db
ORDER_REPOSITORY_URL=memory://

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
